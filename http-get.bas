10 REM ------------------------------------------------------------
20 REM LOAD A WEB PAGE USING SWIFTLINK (DIRECT $DE00)
30 REM C64U: NMI RING BUF FOR RX; ISR AT $C000 NOT $0C00
40 REM ------------------------------------------------------------
45 REM PA=PAUSE TL=MODEM TX TD=GET TX DS=XL
46 REM BASIC 1MHZ: TD=2500 ~2S/BYTE; TL=125 ~100MS (MODEM ONLY)
47 REM TEST: PA=50 TL=125 TD=2500 DS=2000 XL=8000
48 REM PROD: PA=500 TL=125 TD=2500 DS=3000 XL=50000
50 TG$="":TT=0:ST$="":WT=0:TW=0:RM=0:MD=0
55 PA=50:TL=125:TD=2500:DS=2000:DB=1:XL=8000
60 DR=56832:SR=56833:CM=56834:CT=56835
70 RH=167:RT=168:RB=49664
100 REM CLEAR SCREEN
110 PRINT CHR$(147);CHR$(14);CHR$(5);"CONNECTING ...":S=0
120 REM RESET ACIA
130 POKE SR,0
140 REM 1200 BAUD ON C64U 1MHZ (CHR$(8) OR 16 = PEEK 56835 OF 24)
150 POKE CT,24
160 REM DTR ON, POLLED CMD (CM=9)
170 POKE CM,9
175 ST$=">> 1 ACIA INIT":GOSUB 600
180 GOSUB 650
185 ST$=">> 2 NMI INSTALL":GOSUB 600
190 GOSUB 2000
195 ST$=">> 3 DRAIN PRE":GOSUB 600
200 GOSUB 3100
205 ST$=">> 4 HANGUP":GOSUB 600
210 GOSUB 3000
215 ST$=">> 5 DRAIN POST":GOSUB 600
220 GOSUB 3100
225 ST$=">> 6 AT":GOSUB 600
230 TS$="AT"+CHR$(10):GOSUB 700
240 GOSUB 650
245 ST$=">> 7 DIAL":GOSUB 600
250 REM DIAL TCP SERVER
260 TS$="ATDT PHP.RETROGAMECODERS.COM:80"+CHR$(10)
270 GOSUB 700
275 ST$=">> 8 SETTLE":GOSUB 600
280 REM C64U: NO CONNECT TEXT; SETTLE WHILE ISR FILLS RING
290 PA=DS:GOSUB 650
295 ST$=">> 9 DRAIN DIAL":GOSUB 600
300 GOSUB 3100
310 CRLF$=CHR$(13)+CHR$(10)
315 ST$=">> 10 GET SEND":GOSUB 600
320 PRINT "SENDING GET...";
330 TS$="GET / HTTP/1.1"+CRLF$
340 TS$=TS$+"HOST: PHP.RETROGAMECODERS.COM"+CRLF$+CRLF$
345 MD=1
350 GOSUB 700
355 PA=500:GOSUB 650
365 ST$=">> 11 SKIP HEADERS":GOSUB 600
370 CR=0:WT=0:RM=0:HB=0:HD$=""
380 GOSUB 900
385 PRINT CHR$(C);
386 HD$=HD$+CHR$(C):IF LEN(HD$)>120 THEN HD$=RIGHT$(HD$,120)
390 IF C<>10 AND C<>13 THEN HB=1:CR=0:GOTO 380
400 CR=CR+1:IF CR<4 THEN 380
401 IF HB=0 THEN PRINT:PRINT ">> BAD HDR":GOSUB 3100:GOTO 350
402 GOSUB 580
403 IF ER=1 THEN PRINT:PRINT ">> MODEM ERROR":GOSUB 3000:GOTO 10
404 IF HE=0 THEN PRINT:PRINT ">> NO HTTP":GOSUB 3100:GOTO 350
405 ST$=">> 12 MAIN LOOP":GOSUB 600
407 RM=1:WT=0
410 REM MAIN LOOP - READ NMI RING (NOT PEEK(SR) BIT 3)
420 GOSUB 900
430 PRINT CHR$(C);
440 IF C>=97 AND C<=122 THEN C=C-32
450 IF C=ASC("<") THEN TT=1:TG$="":GOTO 420
460 IF C=ASC(">") THEN TT=0:GOTO 420
470 IF TT=1 THEN TG$=TG$+CHR$(C)
480 IF TT=0 AND TG$<>"" THEN GOSUB 1000
490 IF TT=0 AND TG$="" THEN GOSUB 3200
500 GOTO 420
510 END
580 REM SCAN HD$ FOR HTTP OR ERROR
581 HE=0:ER=0:L=LEN(HD$)
582 IF L<5 THEN RETURN
583 FOR I=1 TO L-3
584 IF MID$(HD$,I,4)="HTTP" THEN HE=1
585 NEXT I
586 FOR I=1 TO L-4
587 IF MID$(HD$,I,5)="ERROR" THEN ER=1
588 NEXT I
589 RETURN
600 REM DEBUG PRINT ST$ IF DB=1
605 IF DB=0 THEN RETURN
610 PRINT:PRINT ST$
620 RETURN
650 REM PAUSE PA ITERATIONS (~PA/50 SEC AT 1MHZ)
660 FOR W=1 TO PA:NEXT
670 RETURN
700 REM SEND STRING TS$
710 FOR I=1 TO LEN(TS$)
720 B=ASC(MID$(TS$,I,1))
730 GOSUB 800
740 NEXT
750 RETURN
800 REM SEND ONE BYTE IN B (PETSCII->ASCII + SLOW TX)
810 TW=0
815 S=PEEK(SR)
816 IF (S AND 16)<>0 THEN 830
817 TW=TW+1
818 IF DB AND TW=500 THEN PRINT ">> TX WAIT SR=";S:TW=0
820 GOTO 815
830 IF B>=193 AND B<=218 THEN B=B-128
840 IF B>=65 AND B<=90 THEN B=B+32
850 POKE DR,B
855 IF MD=0 THEN FOR W=1 TO TL:NEXT:RETURN
860 FOR W=1 TO TD:NEXT
870 RETURN
895 REM ASCII FROM MODEM -> PETSCII FOR PRINT
896 IF C>=65 AND C<=90 THEN C=C+128:RETURN
897 IF C>=97 AND C<=122 THEN C=C-32:RETURN
898 RETURN
900 REM BLOCKING READ ONE BYTE FROM RING INTO C
910 H=PEEK(RH):T=PEEK(RT)
915 IF H<>T THEN 930
916 WT=WT+1
917 IF DB AND (WT=1 OR WT=500) THEN PRINT ">> RX WAIT SR=";PEEK(SR);
918 IF DB AND (WT=1 OR WT=500) THEN PRINT " H=";PEEK(RH);" T=";PEEK(RT)
919 IF RM=1 AND WT>=XL THEN PRINT ">> RX TIMEOUT":GOSUB 3000:END
920 IF H=T THEN 910
930 C=PEEK(RB+H):GOSUB 895
940 H=H+1:IF H>255 THEN H=0
945 POKE RH,H:WT=0
948 RETURN
1000 REM PROCESS HTML TAG IN TG$
1040 IF TG$="H1" THEN PRINT CHR$(147);CHR$(18);CHR$(159);:TG$="":RETURN
1050 IF TG$="/H1" THEN PRINT CHR$(156);CHR$(5);CHR$(13);:TG$="":RETURN
1055 IF TG$="H2" THEN PRINT CHR$(158);:TG$="":RETURN
1060 IF TG$="/H2" THEN PRINT CHR$(13);CHR$(5);:TG$="":RETURN
1065 IF TG$="P" THEN PRINT CHR$(13);CHR$(13);:TG$="":RETURN
1070 IF TG$="LI" THEN PRINT CHR$(5);CHR$(119);" ";:TG$="":RETURN
1075 IF TG$="/LI" THEN TG$="":RETURN
1095 IF TG$="/HTML" THEN GOSUB 3000:END
1099 TG$="":RETURN
2000 REM INSTALL 38-BYTE NMI ISR AT $C000
2010 RESTORE:AD=49152
2020 READ B:IF B<0 THEN 2070
2030 POKE AD,B:AD=AD+1:GOTO 2020
2070 POKE RH,0:POKE RT,0
2080 POKE 792,0:POKE 793,192
2090 RETURN
2091 DATA 72,138,72,152,72,173,1,222,162,11,142,2,222,41,8,240,15
2092 DATA 173,0,222,164,168,153,0,194,230,168,169,9,141,2,222,104
2093 DATA 168,104,170,104,64,-1
3000 REM HANGUP (+++ THEN ATH)
3010 TS$="+++":GOSUB 700
3020 PA=100:GOSUB 650
3030 TS$="ATH"+CHR$(10):GOSUB 700
3040 PA=150:GOSUB 650
3050 RETURN
3100 REM DRAIN RING UNTIL QUIET
3110 Q=0:DT=0
3115 IF DB THEN PRINT:PRINT ">> DRAIN";
3120 H=PEEK(RH):T=PEEK(RT)
3130 IF H=T THEN GOTO 3160
3140 C=PEEK(RB+H):GOSUB 895:PRINT CHR$(C);
3150 H=H+1:IF H>255 THEN H=0
3155 POKE RH,H:Q=0:GOTO 3120
3160 Q=Q+1:DT=DT+1:IF Q<20 AND DT<400 THEN 3120
3170 RETURN
3200 REM BUILD/PRINT BODY BYTES
3210 IF LEN(ST$)<40 AND C<>13 THEN ST$=ST$+CHR$(C)
3220 IF LEFT$(ST$,15)="400 BAD REQUEST" THEN PRINT CHR$(5);" RETRY!":GOTO 10
3240 PRINT CHR$(C);
3250 RETURN
